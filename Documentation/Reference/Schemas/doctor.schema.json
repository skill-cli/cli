{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill diagnosis, version 1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "skills"
                },
                "id": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "ok",
                    "warning",
                    "error"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "id",
                "status",
                "message"
              ]
            }
          }
        },
        "required": [
          "root",
          "scope",
          "ok",
          "checks"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "ok",
    "roots"
  ]
}
