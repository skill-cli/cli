{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Available skill list, version 1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "source"
    },
    "scope": {
      "enum": [
        "project",
        "user"
      ]
    },
    "source": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "skillFile": {
            "type": "string"
          },
          "plugin": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "path",
          "skillFile"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "scope",
    "source",
    "skills"
  ]
}
