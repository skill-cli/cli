{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill restoration, version 1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "enum": [
        "project",
        "user"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "agent",
          "mode",
          "path"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "scope",
    "skills"
  ]
}
