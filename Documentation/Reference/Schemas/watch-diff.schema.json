{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Watch diff, version 1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "enum": [
        "project",
        "user"
      ]
    },
    "source": {
      "allOf": [
        {
          "$ref": "watch-status.schema.json#/$defs/source"
        },
        {
          "type": "object",
          "properties": {
            "changes": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "watch-status.schema.json#/$defs/item"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "files": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/fileChange"
                        }
                      }
                    },
                    "required": [
                      "files"
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "scope",
    "source"
  ],
  "$defs": {
    "fileChange": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Item-relative entry path."
        },
        "before": {
          "$ref": "#/$defs/fileEntry"
        },
        "after": {
          "$ref": "#/$defs/fileEntry"
        }
      },
      "required": [
        "path"
      ]
    },
    "fileEntry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "file"
            },
            "base64": {
              "type": "string",
              "contentEncoding": "base64"
            },
            "executable": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "base64",
            "executable"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "directory"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "symlink"
            },
            "destination": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "destination"
          ]
        }
      ]
    }
  }
}
